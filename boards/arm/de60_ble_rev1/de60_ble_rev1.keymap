#include "../common.keymap"

#define WIN 0
#define WIN_FN 1
#define MAC 2
#define MAC_FN 3

/ {
    macros {
        win_logout: win_logout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp L>, <&macro_release &kp LGUI>;
        };

        win_login: win_login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LCTRL &kp LALT>, <&macro_tap &kp DEL>, <&macro_release &kp LCTRL &kp LALT>;
        };

        pass91: pass91 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N1 &kp N &kp A &kp EXCL>;
        };

        pass90: pass90 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N9 &kp N0 &kp N &kp A &kp EXCL>;
        };

        corp_domain: corp_domain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp C &kp O &kp R &kp P &kp BSLH &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        domain_name: domain_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        gen_id: gen_id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp N1 &kp N5 &kp N7 &kp N9 &kp N8 &kp N6 &kp N7 &kp N5>;
        };

        macro_name: macro_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LS(N) &kp G &kp U &kp Y &kp E &kp E &kp N &kp X &kp SPACE &kp LS(H) &kp A &kp I &kp R &kp SPACE &kp LS(K) &kp Y &kp R>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Win";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &mo WIN_FN
&none      &kp LGUI  &kp LALT                                &kp SPACE                     &none     &kp RALT  &kp RALT  &win_login &none
            >;
        };

        win_function_layer {
            label = "Win Function";
            bindings = <
&kp GRAVE    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &DE_BLD      &gen_id
&DE_USB      &DE_BT1   &DE_BT2   &DE_BT3   &none     &none     &none     &none     &none     &none     &kp PSCRN &kp SLCK  &kp PAUSE_BREAK &gen_id
&kp CAPS     &none     &none     &DE_OZW   &none     &none     &none     &none     &none     &none     &kp LEFT  &kp RIGHT           &macro_name
&domain_name &none     &none     &none     &none     &none     &none     &none     &none     &none     &kp UP    &win_logout &trans      &trans
&none        &pass91   &pass90                                 &none                         &none     &none     &none     &corp_domain &none
            >;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &mo MAC_FN
&none      &kp LALT  &kp LGUI                                &kp SPACE                     &none     &kp RGUI  &kp RGUI  &win_login &none
            >;
        };

        mac_function_layer {
            label = "Mac Function";
            bindings = <
&kp GRAVE    &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp GLOBE &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &DE_BLD &gen_id
&DE_USB      &DE_BT1      &DE_BT2      &DE_BT3   &none     &none     &none     &none     &none     &none     &none     &UGSPD    &UGSPI    &gen_id
&kp CAPS     &none        &none        &DE_OZW   &none     &none     &none     &none     &none     &none     &kp LEFT  &kp RIGHT           &macro_name
&domain_name &none        &none        &none     &none     &none     &none     &none     &none     &none     &kp UP    &win_logout &trans   &trans
&none        &to WIN      &none                                      &none                         &none     &none     &none     &corp_domain &none
            >;
        };

        layer_4 { status = "reserved"; };
        layer_5 { status = "reserved"; };

    };
};
