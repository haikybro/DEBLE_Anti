#include "../common.keymap"

#define WIN 0
#define WIN_FN 1
#define MAC 2
#define MAC_FN 3

#define UF_RESET &DE_BLD
#define Device_USB &DE_USB
#define UF_BT1 &DE_BT1
#define UF_BT2 &DE_BT2
#define UF_BT3 &DE_BT3

/ {
    macros {
        domain_name: domain_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        gen_id: gen_id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp N1 &kp N5 &kp N7 &kp N9 &kp N8 &kp N6 &kp N7 &kp N5>;
        };

        macro_name: macro_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LS(N) &kp G &kp U &kp Y &kp E &kp E &kp N &kp X &kp SPACE &kp LS(H) &kp A &kp I &kp R &kp SPACE &kp LS(K) &kp Y &kp R>;
        };

        pass91: pass91 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N1 &kp N &kp A &kp EXCL>;
        };

        pass90: pass90 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N9 &kp N0 &kp N &kp A &kp EXCL>;
        };

        corp_domain: corp_domain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp C &kp O &kp R &kp P &kp BSLH &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        macro_code: macro_code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&none>;
        };

        open_nx: open_nx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&open_zmks>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Win";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DELETE
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp RET
&kp LSHFT  &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHIFT &mo WIN_FN
&trans     &kp LGUI  &kp LALT                                &kp SPACE                     &none     &kp RALT  &kp RALT  &kp LC(LA(DEL)) &trans
            >;
        };

        win_function_layer {
            label = "Win Function";
            bindings = <
&trans        &kp F1    &kp F2    &kp F3      &kp F4   &kp F5   &kp F6   &kp F7  &kp F8   &kp F9    &kp F10   &kp F11       &kp F12        &DE_BLD      &kp INSERT
&trans        &trans    &kp UP    &DE_USB     &DE_BT1  &DE_BT2  &DE_BT3  &trans  &trans   &trans    &kp UP    &kp PAGE_UP   &kp PAGE_DOWN  &gen_id 
&trans        &kp LEFT  &kp DOWN  &kp RIGHT   &trans   &trans   &trans   &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT     &macro_name
&domain_name  &none     &soft_off &trans      &macro_code &bt BT_CLR_ALL &trans &open_nx &trans &trans &trans   &kp LG(L)     &kp LC(LA(DEL)) &trans
&trans        &pass91   &pass90                                &trans                            &none     &none     &kp CLCK  &corp_domain &trans
            >;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DELETE
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp RET
&kp LSHFT  &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHIFT &mo MAC_FN
&trans     &kp LALT  &kp LGUI                                &kp SPACE                     &none     &kp RGUI  &kp RGUI  &kp LC(LA(DEL)) &trans
            >;
        };

        mac_function_layer {
            label = "Mac Function";
            bindings = <
&trans        &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp GLOBE &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &DE_BLD &kp INSERT
&trans        &trans       &kp UP       &DE_USB      &DE_BT1   &DE_BT2  &DE_BT3  &trans  &trans   &trans    &kp UP    &kp PAGE_UP   &kp PAGE_DOWN  &gen_id 
&trans        &kp LEFT     &kp DOWN     &kp RIGHT    &trans    &trans   &trans   &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT     &macro_name
&domain_name  &none        &soft_off    &trans       &macro_code &bt BT_CLR_ALL &trans &open_nx &trans &trans &trans   &kp LG(L)     &kp LC(LA(DEL)) &trans
&trans        &to WIN      &none                                       &trans                            &none     &none     &kp CLCK  &corp_domain &trans
            >;
        };

        layer_4 { status = "reserved"; };
        layer_5 { status = "reserved"; };

    };
};
